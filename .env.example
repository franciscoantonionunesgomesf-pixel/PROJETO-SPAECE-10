# Copie este arquivo para .env e preencha os valores.
# Para rodar apenas a interface (acervo, busca, filtro, modal, PDF),
# os valores podem ficar vazios.

NODE_ENV=development
PORT=3000

# Banco de dados (opcional para a interface principal)
DATABASE_URL=

# Sessão / autenticação
JWT_SECRET=troque-por-uma-chave-segura
OWNER_OPEN_ID=

# OAuth (Manus) — opcional em ambiente local
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# LLM (gerador com IA) — opcional em ambiente local
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
